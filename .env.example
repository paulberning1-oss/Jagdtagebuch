# Kopiere diese Datei nach ".env" und trage deinen Schlüssel ein.
# Die Datei .env wird NICHT ins Git-Repository übernommen.
#
# Google Map Tiles API (optional). Ohne Schlüssel wird die Ebene
# "Google Satellit" einfach ausgeblendet.
# WICHTIG: Den Schlüssel in der Google Cloud Console auf deine
# Web-Adressen beschränken (siehe README, Abschnitt "Google-Schlüssel").
VITE_GOOGLE_MAPS_API_KEY=

# Konto + Cloud-Speicher (Supabase). Ohne diese Werte speichert die App nur auf dem Gerät.
# Supabase-Dashboard → Project Settings → API Keys: "Project URL" und "anon / publishable key".
# NIE den "service_role"/"secret"-Key eintragen!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
